    "temperature = 310\n",
    "viscosity = 0.001\n",
    "radius = 50e-9\n",
    "\n",
    "D = (kB*temperature)/(6*np.pi*viscosity*radius)\n",
    "print(D)\n",
    "\n",
    "dt = 0.01\n",
    "\n",
    "step_size = np.sqrt(2*D*dt)\n",
    "x[i] = x[i-1] + np.random.normal()*step_size\n",
